# หน้าที่ของไฟล์นี้: แม่แบบรายชื่อ environment variables; ใส่เพียงค่าตัวอย่างและห้ามบันทึกความลับจริง
# ผู้อ่านทั่วไปควรดูคู่มือใน docs ควบคู่กับคอมเมนต์ใกล้กฎสำคัญ
DATABASE_URL="postgresql://app:change-me@localhost:5432/yuyen?schema=public"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
SESSION_SECRET="generate-at-least-32-random-bytes"
TOTP_ENCRYPTION_KEY="base64-encoded-32-byte-key"
# Optional keyring for rotation. Keep old keys until every account has migrated.
TOTP_ENCRYPTION_KEYS='{"1":"base64-encoded-old-32-byte-key","2":"base64-encoded-current-32-byte-key"}'
TOTP_ENCRYPTION_CURRENT_VERSION="1"
SESSION_IDLE_MINUTES="30"
SESSION_ABSOLUTE_HOURS="12"
AUTH_SESSION_RETENTION_DAYS="30"
AUTH_THROTTLE_RETENTION_DAYS="7"
AUTH_RATE_LIMIT_ATTEMPTS="5"
AUTH_RATE_LIMIT_MINUTES="15"
# 0 = ignore forwarding headers. Set to the exact number of reverse proxies
# controlled by your deployment (commonly 1) only when they overwrite/append
# X-Forwarded-For correctly.
AUTH_TRUSTED_PROXY_HOPS="0"
S3_ENDPOINT=""
# Browser-reachable endpoint used for signed URLs and the CSP. Leave empty when
# it equals S3_ENDPOINT; set it when the app reaches storage by an internal name.
S3_PUBLIC_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
S3_CONNECTION_TIMEOUT_MS="5000"
S3_REQUEST_TIMEOUT_MS="30000"
MEDIA_SIGNED_URL_SECONDS="300"
MALWARE_SCAN_MODE="disabled"
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"
CLAMAV_TIMEOUT_MS="30000"
BOOTSTRAP_ADMIN_USERNAME="owner"
BOOTSTRAP_ADMIN_PASSWORD="set-a-temporary-secret-outside-source-control"
# Optional contact values shown only until company details are first saved in the CMS.
# Development falls back to built-in sample values; production hides any value left unset.
# Privacy-notice contact and approval are set in the CMS (นโยบายเว็บไซต์), not here.
NEXT_PUBLIC_COMPANY_PHONE_DISPLAY="02-000-0000"
NEXT_PUBLIC_COMPANY_PHONE_HREF="+6620000000"
NEXT_PUBLIC_COMPANY_EMAIL="contact@example.co.th"
NEXT_PUBLIC_COMPANY_LINE_LABEL="@yuyenengineering"
NEXT_PUBLIC_COMPANY_LINE_URL="https://line.me/R/ti/p/@your-line-id"
NEXT_PUBLIC_COMPANY_FACEBOOK_URL="https://www.facebook.com/your-page"
NEXT_PUBLIC_COMPANY_ADDRESS="ที่อยู่ที่เจ้าของบริษัทยืนยันแล้ว"
NEXT_PUBLIC_COMPANY_MAPS_URL="https://maps.google.com/?q=your-confirmed-location"
NEXT_PUBLIC_COMPANY_MAPS_EMBED_URL="https://www.google.com/maps/embed?pb=your-embed-parameters"
