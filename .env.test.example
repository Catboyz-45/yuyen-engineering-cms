# หน้าที่ของไฟล์นี้: แม่แบบรายชื่อ environment variables; ใส่เพียงค่าตัวอย่างและห้ามบันทึกความลับจริง
# ผู้อ่านทั่วไปควรดูคู่มือใน docs ควบคู่กับคอมเมนต์ใกล้กฎสำคัญ
# Copy this file to .env.test. Never point this URL at development, staging,
# or production. The database name must contain test, e2e, or sandbox.
TEST_DATABASE_URL="postgresql://yuyen_test:change-me@127.0.0.1:55433/yuyen_sandbox?schema=public"

# The test server and same-origin checks must use the same origin.
APP_URL="http://127.0.0.1:3200"
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3200"
PLAYWRIGHT_PORT="3200"
TEST_BASE_URL="http://127.0.0.1:3200"

# Generate test-only values. Do not reuse production secrets.
SESSION_SECRET="replace-with-a-test-only-secret-at-least-32-characters"
TOTP_ENCRYPTION_KEY="replace-with-a-base64-encoded-test-only-32-byte-key"

# Optional isolated object storage used by media E2E tests.
S3_ENDPOINT="http://127.0.0.1:59000"
S3_REGION="us-east-1"
S3_BUCKET="yuyen-test"
S3_ACCESS_KEY_ID="test-only-access-key"
S3_SECRET_ACCESS_KEY="test-only-secret-key"
S3_FORCE_PATH_STYLE="true"
