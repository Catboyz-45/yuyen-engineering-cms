{
  "name": "yuyen-engineering",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:visual": "playwright test tests/visual-accessibility.spec.ts",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "RUN_INTEGRATION=1 tsx scripts/run-with-test-env.ts vitest run --no-file-parallelism tests/database.integration.test.ts tests/cms-workflows.integration.test.ts tests/scheduled-news.integration.test.ts tests/content-lifecycle.integration.test.ts tests/public-content.integration.test.ts",
    "test:e2e": "tsx scripts/run-with-test-env.ts playwright test tests/security.e2e.spec.ts tests/critical-ui.e2e.spec.ts tests/cms-auth.e2e.spec.ts tests/auth-hardening.e2e.spec.ts tests/admin-accounts.e2e.spec.ts tests/media-lifecycle.e2e.spec.ts tests/cms-workflows.e2e.spec.ts",
    "test:e2e:critical": "RUN_CRITICAL_UI_E2E=1 RUN_ADMIN_E2E=1 RUN_AUTH_HARDENING_E2E=1 tsx scripts/run-with-test-env.ts playwright test --workers=1 tests/critical-ui.e2e.spec.ts tests/cms-auth.e2e.spec.ts tests/admin-accounts.e2e.spec.ts tests/auth-hardening.e2e.spec.ts",
    "test:e2e:admins": "RUN_ADMIN_E2E=1 tsx scripts/run-with-test-env.ts playwright test tests/admin-accounts.e2e.spec.ts",
    "test:e2e:media": "RUN_MEDIA_E2E=1 tsx scripts/run-with-test-env.ts playwright test tests/media-lifecycle.e2e.spec.ts",
    "test:e2e:privacy": "tsx scripts/run-with-test-env.ts playwright test tests/privacy.e2e.spec.ts --workers=1",
    "test:security": "npm run test:unit && npm audit --audit-level=high",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:test:migrate:status": "tsx scripts/run-with-test-env.ts prisma migrate status",
    "db:test:migrate:deploy": "tsx scripts/run-with-test-env.ts prisma migrate deploy",
    "db:seed": "prisma db seed",
    "auth:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "auth:recover": "tsx scripts/emergency-recover-admin.ts",
    "auth:cleanup": "tsx scripts/cleanup-auth.ts",
    "media:cleanup": "tsx scripts/cleanup-media.ts",
    "cms:purge-expired": "tsx scripts/purge-expired-content.ts",
    "test:coverage": "RUN_INTEGRATION=1 tsx scripts/run-with-test-env.ts vitest run --no-file-parallelism --coverage.enabled --coverage.provider=v8 --coverage.include='src/**' --coverage.reporter=lcov --coverage.reporter=text-summary"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@prisma/client": "6.19.3",
    "@smithy/node-http-handler": "4.9.13",
    "argon2": "0.45.1",
    "lucide-react": "0.468.0",
    "next": "16.3.6",
    "otpauth": "9.5.1",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "22.17.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv": "17.4.2",
    "eslint": "9.32.0",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.11",
    "tsx": "4.23.1",
    "typescript": "5.8.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.4",
    "deepmerge-ts": "8.0.2",
    "js-yaml": "4.3.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@tailwindcss/oxide@4.1.11": true,
    "argon2@0.45.1": true,
    "esbuild@0.28.1": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  }
}
